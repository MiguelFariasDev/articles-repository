DB_HOST=localhost
DB_PORT=5432
DB_NAME=artigos
DB_USER=postgres
DB_PASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379
AWS_REGION=us-east-1
AWS_SERVICE_URL=http://localhost:4566
S3_BUCKET=articles-repository-pdfs
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:articles-repository-topic
SQS_QUEUE_URL=http://localhost:4566/000000000000/articles-repository-queue
DYNAMODB_TABLE=articles-repository-logs

# Portas do host usadas pelo docker-compose / scripts/run-local.sh
LOCALSTACK_PORT=4566
# Tradução do resumo no Worker (opcional; sem chave usa tradutor mock)
DEEPL_API_KEY=
# Aplica migrations ao iniciar a API (usado em produção/EC2)
Database__MigrateOnStartup=false
